# 构建期精简清单（相对官方 rootfs；# 开头为注释）
# 只删「与无线/SSH/TTYD/页面/NSS/Argon 主题无关」的配置、自启链接、LuCI 控制器。
# 物理二进制不删：不启动就不占内存/CPU，且避免破坏 opkg / 无线依赖。
# 删完必须由 prune.keep 白名单硬断言兜底，误删即停止出包。
# ── 无关配置（含 autoreboot 定时重启，必须清）──
etc/config/autoreboot
etc/config/cnss_diag
etc/config/ddns
etc/config/ddns-go
etc/config/dhcrelay
etc/config/lldpd
etc/config/macsec
etc/config/mia
etc/config/pppoe
etc/config/ripd
etc/config/upnpd
etc/config/zerotier
# ── 自启链接（不启动 = 不占资源）──
etc/rc.d/S50autoreboot
etc/rc.d/S95ddns
etc/rc.d/S99ddns-go
etc/rc.d/S99zerotier
etc/rc.d/S90lldpd
etc/rc.d/S90quagga
etc/rc.d/S91dhcrelay4
etc/rc.d/S50pppoe-server
etc/rc.d/S60pppoe-relay
etc/rc.d/S94miniupnpd
etc/rc.d/S80relayd
etc/rc.d/S30mia
etc/rc.d/S19cnss_diag
etc/rc.d/S12breakpad
etc/rc.d/S98diag_socket_app
etc/rc.d/S35odhcpd
etc/rc.d/S19firewall
# ── LuCI 无关控制器（terminal.lua 必须保留 → TTYD 界面）──
usr/lib/lua/luci/controller/autoreboot.lua
usr/lib/lua/luci/controller/ddns-go.lua
usr/lib/lua/luci/controller/filetransfer.lua
usr/lib/lua/luci/controller/mia.lua
usr/lib/lua/luci/controller/upnp.lua
usr/lib/lua/luci/controller/wireguard.lua
usr/lib/lua/luci/controller/zerotier.lua
