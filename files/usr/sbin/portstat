#!/bin/sh
PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH
# 只读取网口速率，不改驱动、不写配置。官方 5.4.213 自带 ethtool / swconfig。
#
# 背景：QSDK12.2 闭源 qca-nss-dp 的 netdev->phydev 为 NULL，
# .get_link_ksettings 返回 -ENODEV → /sys/class/net/ethX/speed 报 -1 或
# 10M/Half，但链路实际是满速的。这里不写死 1000 冒充，而是去交换芯片
# 读 PHY 实测值（swconfig），并标注来源；读不到就如实标「未上报」。
#
# 第 15 次：默认只列【已插网线的以太网口】——两个丰富页和 Argon 主题页
# 都不再铺一堆口，页面清爽。--all 才看全部（含无线口 / 未插线口）。
list(){ for d in br-lan eth0 eth1 eth2 eth3 ath0 ath1; do
  [ -d "/sys/class/net/$d" ] && printf '%s\n' "$d"; done; }

link_up(){
  d=$1
  [ "$d" = br-lan ] && return 0
  case "$d" in eth*) ;; *) return 1 ;; esac
  c=$(cat "/sys/class/net/$d/carrier" 2>/dev/null || echo 0)
  [ "$c" = 1 ] && return 0
  # carrier 读不到时，用 ethtool 的 Link detected 兜底
  lk=$(ethtool "$d" 2>/dev/null | sed -n 's/.*Link detected: *//p' | head -1)
  [ "$lk" = yes ] && return 0
  return 1
}

list_up(){ for d in $(list); do link_up "$d" && printf '%s\n' "$d"; done; }

STACK_CLOSED=0
case "$(uname -r 2>/dev/null)" in *5.4.213*) STACK_CLOSED=1 ;; esac
[ -e /lib/modules/5.4.213/qca-nss-dp.ko ] && STACK_CLOSED=1
[ "$STACK_CLOSED" = 0 ] && grep -q 'qca_ol' /proc/modules 2>/dev/null && STACK_CLOSED=1

PHY_SPEED=''; PHY_DUPLEX=''; PHY_DEV=''
phy_link_probe(){
  _sw=$(command -v swconfig 2>/dev/null); [ -z "$_sw" ] && _sw=/sbin/swconfig
  [ -x "$_sw" ] || return 0
  for _d in $("$_sw" list 2>/dev/null \
      | sed -n 's/.*Found:[[:space:]]*\([^[:space:],]*\).*/\1/p' | tr '\n' ' '); do
    [ -n "$_d" ] || continue
    _o=$("$_sw" dev "$_d" show 2>/dev/null) || continue
    _s=$(printf '%s\n' "$_o" | grep -oE 'speed:[[:space:]]*[0-9]+' \
         | grep -oE '[0-9]+' | sort -n | tail -n 1)
    _u=$(printf '%s\n' "$_o" | grep -oE 'duplex:[[:space:]]*(full|half)' \
         | head -n 1 | sed 's/.*://;s/[[:space:]]//g')
    case "$_s" in ''|*[!0-9]*) continue ;; esac
    [ "$_s" -gt 0 ] 2>/dev/null || continue
    PHY_SPEED=$_s; PHY_DUPLEX=${_u:-full}; PHY_DEV=$_d
    return 0
  done
  return 0
}
[ "$STACK_CLOSED" = 1 ] && phy_link_probe

# 单口取值：返回 "speed|duplex|link|src|note"
one(){
  d=$1
  sp=$(cat "/sys/class/net/$d/speed" 2>/dev/null || echo -1)
  case "$sp" in ''|*[!0-9]*|'-1') sp=0 ;; esac
  du=$(ethtool "$d" 2>/dev/null | sed -n 's/.*Duplex: *//p' | head -1)
  lk=$(ethtool "$d" 2>/dev/null | sed -n 's/.*Link detected: *//p' | head -1)
  [ -z "$du" ] && du='unknown'; [ -z "$lk" ] && lk='unknown'
  [ "$d" = br-lan ] && { du='-'; lk='up'; }
  src='netdev'; note='netdev ethtool 上报'
  if [ "$d" != br-lan ]; then
    if [ "$sp" -eq 0 ] 2>/dev/null || { [ "$sp" -le 10 ] 2>/dev/null && [ "$du" = half ]; }; then
      if [ -n "$PHY_SPEED" ]; then
        sp=$PHY_SPEED; du=$PHY_DUPLEX
        src='phy'; note="交换芯片 PHY 实测（$PHY_DEV / swconfig），非 netdev 上报"
      else
        src='none'; note='驱动不上报协商速率，链路实际可能正常（以实测吞吐为准）'
      fi
    fi
  fi
  printf '%s|%s|%s|%s|%s\n' "$sp" "$du" "$lk" "$src" "$note"
}

# json <up|all>
json(){
  [ "${1:-up}" = all ] && _l=list || _l=list_up
  printf '{"phy":{"speed":%s,"duplex":"%s","dev":"%s"},"ports":[' \
    "${PHY_SPEED:-0}" "${PHY_DUPLEX:-}" "${PHY_DEV:-}"
  first=1
  for d in $($_l); do
    IFS='|' read -r sp du lk src note <<EOF
$(one "$d")
EOF
    [ $first = 0 ] && printf ','; first=0
    printf '{"if":"%s","speed":%s,"duplex":"%s","link":"%s","src":"%s","note":"%s"}' \
      "$d" "$sp" "$du" "$lk" "$src" "$note"
  done
  printf ']}'
}

# rows <up|all>
rows(){ [ "${1:-up}" = all ] && _l=list || _l=list_up
  for d in $($_l); do printf '%s|%s\n' "$d" "$(one "$d")"; done; }

L=up
case "${1:-}" in --all) L=all; shift ;; esac
case "${1:-}" in
  --json)     json "$L" ;;
  --json-up)  json up ;;
  --rows)     rows "$L" ;;
  --rows-up)  rows up ;;
  *) printf '  %-8s %-8s %-8s %-6s %s\n' '端口' '速率' '双工' 'Link' '来源'
     for d in $( [ "$L" = all ] && list || list_up ); do
       IFS='|' read -r sp du lk src note <<EOF
$(one "$d")
EOF
       [ "$sp" = 0 ] && sp='未上报'
       printf '  %-8s %-8s %-8s %-6s %s\n' "$d" "${sp}" "$du" "$lk" "$note"
     done
     [ -n "$PHY_SPEED" ] && printf '\n  ★ 交换芯片 PHY 实测：%s Mb/s / %s（%s）\n' \
       "$PHY_SPEED" "$PHY_DUPLEX" "$PHY_DEV" ;;
esac
