#!/bin/sh
# 网桥 WDS 自动配对：主(ap) / 客户端(sta) 角色收敛 + 4addr 纯二层桥接配置
# 🔴 绝不重建 radio、绝不删改已有 wifi-iface、绝不 wifi down、绝不重启机器。
#    只新增一个命名段 wireless.wds_z（QSDK 原生识别），一次 /sbin/wifi reload。
PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH
D=/etc/vs010
ROLE=$D/role; PEER=$D/peer; STATE=$D/wds.state
WDS_SEC=wds_z
WDS_SSID=WDS-Bridge-Z
WDS_KEY=WDS123456
log(){ logger -t vs010-wds-pair "$*" 2>/dev/null || true; }
vap(){ for i in ath1 wifi1 wlan1 ath0 wifi0; do
  [ -d "/sys/class/net/$i" ] && { echo "$i"; return; }; done; echo ''; }
mymac(){ for i in br-lan eth0 eth1; do
  [ -r "/sys/class/net/$i/address" ] && { tr -d '\n' < "/sys/class/net/$i/address"; return; }; done; echo ''; }
scan(){
  v=$(vap); [ -z "$v" ] && return 0
  if command -v wlanconfig >/dev/null 2>&1; then
    wlanconfig "$v" list scan 2>/dev/null | sed -n 's/^\([0-9a-fA-F:][0-9a-fA-F:]*\).*/\1/p' | head -8
  elif command -v iw >/dev/null 2>&1; then
    iw dev "$v" scan 2>/dev/null | sed -n 's/^BSS \([0-9a-fA-F:]*\).*/\1/p' | head -8
  fi
}
dev5g(){
  # 找 5G radio 的命名段（QSDK: wifi0=2.4G / wifi1=5G）
  for d in $(uci show wireless 2>/dev/null \
             | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
    hw=$(uci -q get "wireless.$d.hwmode" 2>/dev/null)
    ch=$(uci -q get "wireless.$d.channel" 2>/dev/null)
    # channel 优先（最可靠）；hwmode 只认结尾 a / ac / axa，
    # 🔴 不能用 11a 通配 —— 2.4G 的 11axg 也含 11a，会误选 2.4G
    case "$ch" in 36|40|44|48|52|56|60|64|100|104|108|112|116|120|124|128|132|136|140|144|149|153|157|161|165) echo "$d"; return ;; esac
    case "$hw" in *a|*ac*|*axa*) echo "$d"; return ;; esac
  done
  echo wifi1
}
decide(){
  my=$(mymac | tr 'a-f' 'A-F')
  best=''
  for m in $(scan); do
    M=$(printf '%s' "$m" | tr 'a-f' 'A-F')
    [ "$M" = "$my" ] && continue
    [ -z "$best" ] && best=$M
    [ "$(printf '%s\n%s\n' "$M" "$best" | LC_ALL=C sort | head -1)" = "$M" ] && best=$M
  done
  # 手工指定角色时只更新对端，不覆盖 role
  if [ ! -f "$D/wds.manual" ]; then
    if [ -z "$my" ]; then printf 'unknown\n' > "$ROLE"
    elif [ -z "$best" ]; then printf 'ap\n' > "$ROLE"
    elif [ "$(printf '%s\n%s\n' "$my" "$best" | LC_ALL=C sort | head -1)" = "$my" ]; then
      printf 'ap\n' > "$ROLE"
    else
      printf 'sta\n' > "$ROLE"
    fi
  fi
  printf '%s\n' "$best" > "$PEER"
  printf 'role=%s peer=%s vap=%s t=%s\n' \
    "$(cat "$ROLE" 2>/dev/null)" "$best" "$(vap)" "$(date +%H:%M:%S)" > "$STATE"
  # 联动机器狗：解析到对端 IP 才设 peer，绝不因查不到就判不通
  p=$(cat "$PEER")
  if [ -n "$p" ] && command -v bridge-watchdog >/dev/null 2>&1; then
    low=$(printf '%s' "$p" | tr 'A-F' 'a-f')
    ip=$(ip neigh show dev br-lan 2>/dev/null \
         | awk -v m="$low" 'tolower($3)==m{print $1;exit}')
    [ -n "$ip" ] && bridge-watchdog set-peer "$ip" >/dev/null 2>&1 || true
  fi
}
apply(){
  [ -f /etc/config/wireless ] || { log 'wireless 未生成，稍后重试'; return 1; }
  d=$(dev5g)
  role=$(cat "$ROLE" 2>/dev/null || echo ap)
  [ "$role" = sta ] || role=ap
  # ★ 5G 桥接走 HE160：QSDK qcawifi.sh 对 `11axa + HT160` 转 11AHE160，
  #   `11ac + HT160` 转 11ACVHT160；channel 36 是 160MHz 合法主信道。
  uci -q set "wireless.$d.hwmode=11axa"
  uci -q set "wireless.$d.htmode=HT160"
  uci -q set "wireless.$d.channel=36"
  uci -q set "wireless.$d.disabled=0"
  # ★ 2.4G 不桥接：清掉可能残留的 wds 标记，保留普通 AP 本地覆盖
  for sec in $(uci show wireless 2>/dev/null \
               | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
    [ "$sec" = "$WDS_SEC" ] && continue
    dev=$(uci -q get "wireless.$sec.device" 2>/dev/null)
    [ "$dev" = "$d" ] && continue          # 5G 上其它 VAP 不动
    uci -q delete "wireless.$sec.wds"        2>/dev/null || true
    uci -q delete "wireless.$sec.wds_bridge" 2>/dev/null || true
    [ "$(uci -q get "wireless.$sec.mode" 2>/dev/null)" = wds ] \
      && uci -q set "wireless.$sec.mode=ap" || true
  done
  # 备份一次（只供 off 参考，不整体覆盖）
  [ -f "$D/wireless.orig" ] || cp -f /etc/config/wireless "$D/wireless.orig" 2>/dev/null || true
  uci -q set "wireless.$WDS_SEC=wifi-iface"
  uci -q set "wireless.$WDS_SEC.device=$d"
  uci -q set "wireless.$WDS_SEC.network=lan"          # ★ 纯二层，进 br-lan
  uci -q set "wireless.$WDS_SEC.ssid=$WDS_SSID"
  uci -q set "wireless.$WDS_SEC.encryption=psk2+ccmp"
  uci -q set "wireless.$WDS_SEC.key=$WDS_KEY"
  uci -q set "wireless.$WDS_SEC.disabled=0"
  uci -q delete "wireless.$WDS_SEC.wds"        2>/dev/null || true
  uci -q delete "wireless.$WDS_SEC.wds_bridge" 2>/dev/null || true
  if [ "$role" = ap ]; then
    # ★ WDS 主：AP VAP + 4addr（hostapd wds_bridge 把 4addr 帧送进 br-lan）
    uci -q set "wireless.$WDS_SEC.mode=ap"
    uci -q set "wireless.$WDS_SEC.wds=1"
    uci -q set "wireless.$WDS_SEC.wds_bridge=br-lan"
  else
    # ★ WDS 客户端：QSDK 原生 mode=wds → qcawifi.sh 内部设 wds=1 + mode=sta
    uci -q set "wireless.$WDS_SEC.mode=wds"
  fi
  uci -q commit wireless
  log "WDS 应用 role=$role dev=$d ssid=$WDS_SSID network=lan（4addr 纯二层）"
  # 一次标准 reload；失败只告警，绝不重启、绝不 wifi down
  if [ -x /sbin/wifi ]; then
    /sbin/wifi reload >/dev/null 2>&1 \
      || log 'wifi reload 未成功（不重启；可手动 vs010-wds-pair apply）'
  else
    log '缺 /sbin/wifi，配置已写入，重启后生效'
  fi
  printf '%s\n' "$role" > "$D/wds.applied"
  rm -f "$D/wds.pending"
  # 设备名跟随角色：主 WDS-Z / 客户端 WDS-K
  [ -x /usr/sbin/vs010-host ] && /usr/sbin/vs010-host >/dev/null 2>&1 || true
  # 兼容旧版丰富状态页（只读垫片）
  printf '%s\n' "$role" > /etc/bridge_role
  printf '%s\n' "$role" > /etc/qsdk_role
  printf '%s\n' 'auto' > /etc/bridge_role_mode
}
case "${1:-once}" in
  loop)
    sleep 35
    if [ -f "$D/wds.pending" ]; then decide; apply; fi
    while :; do
      [ -f "$D/wds.manual" ] || decide
      sleep 60
    done ;;
  once) decide; cat "$STATE" ;;
  apply) decide; apply; echo 'WDS 配置已应用（/sbin/wifi reload 一次）' ;;
  set-role)
    case "${2:-}" in
      master|ap)   printf 'ap\n'  > "$ROLE"; printf '1\n' > "$D/wds.manual" ;;
      client|sta)  printf 'sta\n' > "$ROLE"; printf '1\n' > "$D/wds.manual" ;;
      auto)        rm -f "$D/wds.manual"; decide ;;
      *) echo '用法: vs010-wds-pair set-role master|client|auto'; exit 1 ;;
    esac
    : > "$D/wds.pending"; apply
    echo "已设为 $2（ssid=$WDS_SSID）" ;;
  off)
    uci -q delete "wireless.$WDS_SEC" 2>/dev/null || true
    uci -q commit wireless
    rm -f "$D/wds.applied" "$D/wds.manual" "$D/wds.pending"
    [ -x /sbin/wifi ] && /sbin/wifi reload >/dev/null 2>&1 || true
    echo 'WDS 段已移除（原有用户 SSID 未动）' ;;
  status)
    echo "role   : $(cat "$ROLE" 2>/dev/null || echo unknown)  (ap=WDS 主 / sta=WDS 客户端)"
    echo "manual : $([ -f "$D/wds.manual" ] && echo 是 || echo 否，自动收敛)"
    echo "peer   : $(cat "$PEER" 2>/dev/null || echo 未发现)"
    echo "vap    : $(vap)   5G radio: $(dev5g)"
    echo "wds    : mode=$(uci -q get wireless.$WDS_SEC.mode 2>/dev/null || echo 未应用) \
ssid=$(uci -q get wireless.$WDS_SEC.ssid 2>/dev/null || echo 未应用) \
network=$(uci -q get wireless.$WDS_SEC.network 2>/dev/null || echo 未应用)"
    echo "5G     : $(uci -q get wireless.$(dev5g).htmode 2>/dev/null || echo '-') \
ch=$(uci -q get wireless.$(dev5g).channel 2>/dev/null || echo '-')（HE160）  |  2.4G 不桥接"
    echo "host   : $(cat /proc/sys/kernel/hostname 2>/dev/null || echo '?')（主 WDS-Z / 客户端 WDS-K）"
    echo "state  : $(cat "$STATE" 2>/dev/null || echo 尚未扫描)"
    echo "注意   : 4addr 是否建立请实机 wlanconfig ath1 list 确认；本脚本不重启机器" ;;
  link)
    v=$(vap); [ -z "$v" ] && { echo '未发现 5G VAP'; exit 1; }
    echo "VAP=$v  WDS=$WDS_SSID"; wlanconfig "$v" list 2>/dev/null | head -12 || true ;;
  *) echo '用法: vs010-wds-pair loop|once|apply|set-role master|client|auto|off|status|link' ;;
esac
