#!/bin/sh
# WDS 网桥主 / 客户端开关（进系统后自行选，不用重刷、不用改串口）
#   主   WDS-Z  → 172.10.10.241 /22，WDS mode=ap + wds=1（4addr 主）
#   客户端 WDS-K → 172.10.10.242 /22，WDS mode=sta/wds（4addr 客户端）
#   AP 模式恒为 241，不受本开关影响。
# 🔴 两种模式、两台机型的 DHCP 服务端都关（kill_dhcp 每次开机跑），
#    内网只允许上级一台发地址；两端都开会把内网搞乱。
PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH
D=/etc/vs010; mkdir -p "$D" 2>/dev/null || true
ROLE=$D/role; IPF=$D/ipaddr; MAN=$D/wds.manual
MODE=$(cat /etc/firmware_mode 2>/dev/null || echo wds)
NM='255.255.252.0'
uci(){ command uci "$@" 2>/dev/null; }

apply_now(){
  ip=$1
  uci -q set network.lan.proto=static
  uci -q set network.lan.ipaddr="$ip"
  uci -q set network.lan.netmask="$NM"
  uci -q commit network
  # 延迟 3 秒重载网络：让本命令/页面先把结果返回，再切 IP
  ( sleep 3; /etc/init.d/network reload >/dev/null 2>&1 ) >/dev/null 2>&1 &
  [ -x /usr/sbin/vs010-host ] && /usr/sbin/vs010-host >/dev/null 2>&1 || true
}

set_role(){
  r=$1; ip=$2; label=$3
  printf '%s\n' "$r"   > "$ROLE"
  printf '%s\n' "$ip"  > "$IPF"
  printf '1\n'         > "$MAN"
  # 无线侧：复用已验证的 set-role（只 converge + /sbin/wifi reload，不碰 IP、不重启）
  if [ -x /usr/sbin/vs010-wds-pair ]; then
    /usr/sbin/vs010-wds-pair set-role "$r" >/dev/null 2>&1 || true
  fi
  apply_now "$ip"
  # DHCP 兜底：切角色后再次确认本机不发地址
  uci -q get dhcp.lan >/dev/null 2>&1 || uci -q set dhcp.lan=dhcp
  uci -q set dhcp.lan.ignore=1
  uci -q set dhcp.lan.ra=off; uci -q set dhcp.lan.dhcpv6=off; uci -q set dhcp.lan.ndp=off
  uci -q commit dhcp
  printf '✅ 已设为【%s】\n' "$label"
  printf '   角色 role=%s | 设备名 %s\n' "$r" "$([ "$r" = sta ] && echo WDS-K || echo WDS-Z)"
  printf '   管理地址 http://%s  （掩码 %s）\n' "$ip" "$NM"
  printf '   🔴 3 秒后网络重载生效：若你正连着旧 IP，请改用上面新地址重新打开页面\n'
  printf '   🔴 本机 DHCP 服务端已关（WDS/AP 都关），内网只允许上级一台 DHCP\n'
  if [ "$MODE" = ap ]; then
    printf '   ⚠ 当前是 AP 模式固件：IP 仍按 241 走，主/客开关只在 WDS 固件生效\n'
  fi
}

case "${1:-status}" in
  master|ap|主)   set_role ap  172.10.10.241 'WDS 主 WDS-Z / .241' ;;
  client|sta|客)  set_role sta 172.10.10.242 'WDS 客户端 WDS-K / .242' ;;
  auto)
    rm -f "$MAN" "$IPF"
    if [ -x /usr/sbin/vs010-wds-pair ]; then
      /usr/sbin/vs010-wds-pair set-role auto >/dev/null 2>&1 || true
    fi
    r=$(cat "$ROLE" 2>/dev/null || echo ap)
    [ "$r" = sta ] && ip=172.10.10.242 || ip=172.10.10.241
    printf '%s\n' "$ip" > "$IPF"
    apply_now "$ip"
    printf '✅ 自动按 MAC 收敛为 %s，地址 http://%s（3 秒后生效）\n' "$r" "$ip" ;;
  status)
    r=$(cat "$ROLE" 2>/dev/null || echo ap)
    ip=$(uci -q get network.lan.ipaddr 2>/dev/null || echo 172.10.10.241)
    h=$(cat /proc/sys/kernel/hostname 2>/dev/null || echo '?')
    m=$(cat "$MAN" 2>/dev/null || echo 0)
    printf '固件模式 : %s\n' "$MODE"
    printf 'WDS 角色 : %s（%s）\n' "$([ "$r" = sta ] && echo '客户端 WDS-K' || echo '主 WDS-Z')" "$r"
    printf '指定方式 : %s\n' "$([ "$m" = 1 ] && echo '手动（本开关）' || echo '自动（按 MAC）')"
    printf '设备名   : %s\n' "$h"
    printf '管理地址 : http://%s / %s\n' "$ip" "$NM"
    printf '本机 DHCP: %s（WDS 与 AP 都关）\n' "$(uci -q get dhcp.lan.ignore 2>/dev/null || echo 1)"
    printf '可选     : vs010-role master（.241）| client（.242）| auto | status\n' ;;
  *) echo '用法: vs010-role status|master|client|auto'; exit 1 ;;
esac
