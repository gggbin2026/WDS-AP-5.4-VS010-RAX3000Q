#!/bin/sh
PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH
# 网桥看门狗 · 插件化（第 60 次口径）：出厂 enabled=0 / dryrun=1，调试由你自己开
# ★ 关键保护：从未成功关联过（单机/未配对/无线没起来）只记日志，绝不重启。
CFG_OK=/etc/vs010/wdog.ever_ok
# 兼容无 uci 的环境（自检/串口急救）：缺命令时静默返回，不刷屏
uci(){ command uci "$@" 2>/dev/null; }
ensure(){ uci -q get wdsdog.main >/dev/null 2>&1 || {
  uci -q set wdsdog.main=wdsdog
  uci -q set wdsdog.main.enabled=0; uci -q set wdsdog.main.dryrun=1
  uci -q set wdsdog.main.delay=5;  uci -q set wdsdog.main.grace=6
  uci -q set wdsdog.main.interval=30; uci -q set wdsdog.main.peer=auto
  uci -q commit; }; }
setv(){ uci -q set "wdsdog.main.$1=$2"; uci -q commit; echo "$1 = $2"; }
log(){ logger -t bridge-watchdog "$*" 2>/dev/null || true; }
wds_if(){ for i in ath1 wlan1 ath0 wlan0; do [ -d "/sys/class/net/$i" ] && { echo "$i"; return; }; done; echo ''; }
assoc(){ i=$(wds_if); [ -z "$i" ] && return 1
  iw dev "$i" station dump 2>/dev/null | grep -q '^Station' && return 0
  iw dev "$i" link 2>/dev/null | grep -q 'Connected' && return 0
  return 1; }
peer_ip(){ p=$(uci -q get wdsdog.main.peer 2>/dev/null)
  [ -n "$p" ] && [ "$p" != auto ] && { echo "$p"; return; }
  i=$(wds_if); [ -z "$i" ] && { echo ''; return; }
  mac=$(iw dev "$i" station dump 2>/dev/null | sed -n 's/^Station \([^ ]*\).*/\1/p' | head -1)
  [ -z "$mac" ] && { echo ''; return; }
  ip neigh show dev br-lan 2>/dev/null | awk -v m="$mac" '$3==m{print $1;exit}' ; }
loop(){
  ensure; grace=$(uci -q get wdsdog.main.grace 2>/dev/null || echo 6)
  sleep $((grace*60))
  bad=0; delay=$(uci -q get wdsdog.main.delay 2>/dev/null || echo 5)
  interval=$(uci -q get wdsdog.main.interval 2>/dev/null || echo 30)
  while :; do
    [ "$(uci -q get wdsdog.main.enabled 2>/dev/null)" = 1 ] || { sleep "$interval"; continue; }
    if assoc; then touch "$CFG_OK"; bad=0
    else
      p=$(peer_ip)
      if [ -n "$p" ] && ping -c1 -W2 "$p" >/dev/null 2>&1; then touch "$CFG_OK"; bad=0
      else
        bad=$((bad+1)); log "链路不通 ${bad}/$((delay*60/interval)) 轮"
        if [ ! -f "$CFG_OK" ]; then log '★ 从未成功关联过：只记录，不重启'
        elif [ "$bad" -ge $((delay*60/interval)) ]; then
          if [ "$(uci -q get wdsdog.main.dryrun 2>/dev/null)" = 1 ]; then log 'dryrun：本应重启，已跳过'
          else log "连续不通 ${delay} 分钟，执行 reboot"; reboot -f; fi
          bad=0
        fi
      fi
    fi
    sleep "$interval"
  done
}
case "${1:-status}" in
  loop) loop ;;
  on) ensure; setv enabled 1; setv dryrun 0; /etc/init.d/vs010-watchdog enable; /etc/init.d/vs010-watchdog restart ;;
  off) ensure; setv enabled 0; /etc/init.d/vs010-watchdog stop ;;
  dryrun) ensure; setv dryrun "${2:-1}" ;;
  set-delay) setv delay "${2:-5}" ;;
  set-interval) setv interval "${2:-30}" ;;
  set-grace) setv grace "${2:-6}" ;;
  set-peer) setv peer "${2:-auto}" ;;
  status)
    ensure
    echo "enabled  : $(uci -q get wdsdog.main.enabled || echo 0)  (0=插件停用)"
    echo "dryrun   : $(uci -q get wdsdog.main.dryrun || echo 1)"
    echo "delay    : $(uci -q get wdsdog.main.delay || echo 5) 分钟"
    echo "interval : $(uci -q get wdsdog.main.interval || echo 30) 秒"
    echo "grace    : $(uci -q get wdsdog.main.grace || echo 6) 分钟"
    echo "peer     : $(uci -q get wdsdog.main.peer || echo auto)"
    echo "ever_ok  : $([ -f "$CFG_OK" ] && echo yes || echo no)"
    echo "wds_if   : $(wds_if)" ;;
  *) echo '用法: bridge-watchdog loop|on|off|dryrun on/off|set-delay N|set-interval N|set-grace N|set-peer IP/auto|status' ;;
esac
