#!/bin/sh
PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH
# NTP 循环同步：同步 -> 睡 300 秒 -> 再同步，无退出条件；单轮失败照样进下一轮
CFG=/etc/vs010/ntp.interval
INTERVAL=$(cat "$CFG" 2>/dev/null || echo 300)
[ "$INTERVAL" -ge 60 ] 2>/dev/null || INTERVAL=300
sync_once(){
  for s in $(uci -q get system.ntp.server 2>/dev/null | tr ' ' '\n'); do
    [ -n "$s" ] || continue
    ntpd -n -q -p "$s" >/dev/null 2>&1 && { logger -t ntp-sync "OK $s"; return 0; }
    busybox ntpd -n -q -p "$s" >/dev/null 2>&1 && { logger -t ntp-sync "OK $s"; return 0; }
  done
  logger -t ntp-sync "本轮全部服务器不可达，跳过（不退出循环）"
  return 1
}
case "${1:-loop}" in
  loop)
    : > /etc/vs010/ntp.round; n=0
    while :; do
      n=$((n+1)); printf '%s\n' "$n" > /etc/vs010/ntp.round
      sync_once || true
      INTERVAL=$(cat "$CFG" 2>/dev/null || echo 300)
      [ "$INTERVAL" -ge 60 ] 2>/dev/null || INTERVAL=300
      sleep "$INTERVAL"
    done ;;
  set-interval)
    n=${2:-300}; [ "$n" -ge 60 ] 2>/dev/null || { echo '最小 60 秒'; exit 1; }
    printf '%s\n' "$n" > "$CFG"; uci -q set ntp-sync.main.interval="$n"; uci -q commit
    echo "间隔 = $n 秒（循环内下一轮自动生效）" ;;
  status)
    echo "interval : $(cat "$CFG" 2>/dev/null || echo 300) 秒（循环）"
    echo "round    : $(cat /etc/vs010/ntp.round 2>/dev/null || echo 0) 轮"
    echo "servers  : $(uci -q get system.ntp.server 2>/dev/null)"
    date ;;
  *) echo '用法: ntp-sync loop | set-interval N | status' ;;
esac
