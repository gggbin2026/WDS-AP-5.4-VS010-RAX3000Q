#!/bin/sh /etc/rc.common
# 5.4 融合固件 · 首启业务配置（幂等；只做 uci 增量，绝不重建 radio/iface）
# 官方 board.d/uci-defaults 生成 network/wireless 之后才跑（START=99）。
START=99
PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH
STAMP=/etc/vs010/applied
BID=$(cat /etc/firmware_build 2>/dev/null || echo unknown)

log(){ logger -t vs010-mode "$*" 2>/dev/null || true; }
uci(){ command uci "$@" 2>/dev/null; }   # 缺 uci 时静默，不刷屏

# ★★ 第 16 次：登录密码 = admin（用户最新拍板；此前两版实际写的是 password 占位 hash）★★
#   官方 /etc/shadow 是 root::（空密码）。旧写法 `printf 'admin\nadmin\n' | passwd root`
#   在 squashfs 只读底层 + 非 tty 下静默失败，且旧 apply() 不管成败都写 stamp，
#   之后每次开机见 stamp 就 return → 密码永久没设上；LuCI 首登还会强制自己设一个。
#   🔴 更硬的坑：上一版 PW_HASH 是带 ... 的占位串，根本不是合法 MD5-crypt，
#      写进 shadow 也验不过。现在换成 openssl passwd -1 -salt VS010Z admin 的真实值，
#      由 verify.sh 每次自检用 openssl 反算校验，杜绝再写占位符。
#   SSH / LuCI / 串口三处同读 /etc/shadow，一次修好。
PW_HASH='$1$VS010Z$UZ4qew78etSeRS5gXbjrR1'
fix_login(){
  SH=${VS010_SHADOW:-/etc/shadow}        # 仅 mock 时覆盖；生产恒为 /etc/shadow
  [ -r "$SH" ] || { log 'shadow 不可读，跳过'; return 0; }
  cur=$(sed -n 's/^root:\([^:]*\):.*/\1/p' "$SH" 2>/dev/null | head -n 1)
  [ "$cur" = "$PW_HASH" ] && return 0
  T=/tmp/.vs010-shadow.$$
  awk -v h="$PW_HASH" 'BEGIN{FS=OFS=":"} /^root:/{$2=h} {print}' "$SH" > "$T" 2>/dev/null \
    || { rm -f "$T"; return 0; }
  # cat > 触发 overlay copy-up；失败再走同目录临时文件 + mv（rename 同样 copy-up）
  if ! cat "$T" > "$SH" 2>/dev/null; then
    cp -f "$T" "${SH}.vs010" 2>/dev/null && mv -f "${SH}.vs010" "$SH" 2>/dev/null || true
  fi
  chmod 600 "$SH" 2>/dev/null || true
  rm -f "$T"
  now=$(sed -n 's/^root:\([^:]*\):.*/\1/p' "$SH" 2>/dev/null | head -n 1)
  [ "$now" = "$PW_HASH" ] && log 'root/admin 已写入 shadow（SSH/LuCI/串口同密）' \
    || log 'shadow 写入未生效（overlay 不可写？可串口 passwd root）'
}

# ★★ 第 15 次：IPv6 全关（每次开机，不受 stamp 限制）★★
#   LuCI「接口 LAN → 高级设置 → 使用内置的 IPv6 管理」读的就是 network.lan.ipv6，
#   旧版只在 apply() 里设一次，board.d 每次开机重新生成后又被打回 1。
kill_ipv6(){
  if uci -q get network.lan >/dev/null 2>&1; then
    uci -q set network.lan.ipv6='0'
    for o in ip6assign ip6prefix ip6class ip6hint ip6ifaceid ip6weight; do
      uci -q delete "network.lan.$o" 2>/dev/null || true
    done
    uci -q set network.globals.ula_prefix='' 2>/dev/null || true
    uci -q delete network.wan6  2>/dev/null || true
    uci -q delete network.globals.ula_prefix 2>/dev/null || true
    uci -q commit network 2>/dev/null || true
  fi
  uci -q get dhcp.lan >/dev/null 2>&1 || uci -q set dhcp.lan=dhcp
  uci -q set dhcp.lan.ra=off
  uci -q set dhcp.lan.dhcpv6=off
  uci -q set dhcp.lan.ndp=off
  for o in ra_management ra_default ra_slaac dhcpv6_passthrough; do
    uci -q delete "dhcp.lan.$o" 2>/dev/null || true
  done
  uci -q delete dhcp.wan6 2>/dev/null || true
  uci -q commit dhcp 2>/dev/null || true
  sysctl -p /etc/sysctl.d/99-vs010-no-ipv6.conf >/dev/null 2>&1 || true
  # 所有已存在网卡逐个关 v6（sysctl 文件只覆盖 all/default）
  for p in /proc/sys/net/ipv6/conf/*/disable_ipv6; do
    [ -w "$p" ] && printf '1\n' > "$p" 2>/dev/null || true
  done
  /etc/init.d/odhcpd stop    2>/dev/null || true
  /etc/init.d/odhcpd disable 2>/dev/null || true
}

# ★★ 第 15 次：本机 DHCP 服务端全关（网桥主/客户端/AP 都不发地址）★★
#   🔴 两端都开 DHCP 会让内网分到不同网段/冲突地址，整网乱掉。
kill_dhcp(){
  uci -q get dhcp.lan >/dev/null 2>&1 || uci -q set dhcp.lan=dhcp
  uci -q set dhcp.lan.ignore='1'
  uci -q set dhcp.lan.dhcpv6='off'
  uci -q set dhcp.lan.ra='off'
  uci -q set dhcp.lan.ndp='off'
  uci -q delete dhcp.wan6 2>/dev/null || true
  uci -q commit dhcp 2>/dev/null || true
  /etc/init.d/dnsmasq stop    2>/dev/null || true
  /etc/init.d/dnsmasq disable 2>/dev/null || true
  /etc/init.d/odhcpd  stop    2>/dev/null || true
  /etc/init.d/odhcpd  disable 2>/dev/null || true
  log '[!!! DHCP !!!] 本机 DHCP 服务端已关闭：WDS 主/客户端、AP 都不发地址；内网只允许上级一台 DHCP，客户端那台也绝不能开'
}

# ★★ 第 15 次：防火墙彻底关（服务 + 自启 + 规则）★★
#   纯二层桥不需要任何 iptables/nft 规则；构建期已删配置/控制器/S19 链接。
kill_firewall(){
  /etc/init.d/firewall stop    2>/dev/null || true
  /etc/init.d/firewall disable 2>/dev/null || true
  /etc/init.d/fw3       stop    2>/dev/null || true
  # 清掉残留规则（有工具才执行，缺工具静默跳过）
  if command -v iptables >/dev/null 2>&1; then
    iptables -F 2>/dev/null || true; iptables -X 2>/dev/null || true
    iptables -t nat -F 2>/dev/null || true; iptables -t nat -X 2>/dev/null || true
  fi
  if command -v ip6tables >/dev/null 2>&1; then
    ip6tables -F 2>/dev/null || true; ip6tables -X 2>/dev/null || true
  fi
  if command -v nft >/dev/null 2>&1; then nft flush ruleset 2>/dev/null || true; fi
}

# ★★ 第 16 次：所有无线信道【自动】★★
#   官方 board.d 每次开机可能重新生成固定 channel；这里统一写 auto。
#   qcawifi.sh:1846 `[ auto = "$channel" ] && channel=0` → ACS 自动选道，合法。
auto_channel(){
  [ -f /etc/config/wireless ] || return 0
  for x in $(uci show wireless 2>/dev/null \
             | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
    [ -n "$x" ] && uci -q set "wireless.$x.channel=auto"
  done
  uci -q commit wireless 2>/dev/null || true
  log '信道自动：全部 wifi-device channel=auto（ACS）'
}

# ★★ 第 15 次：5G 单 SSID 兜底（不依赖 /usr/sbin/vs010-wds-pair 是否存在）★★
#   图里实机 5G 同时广播 Nwrt_5G + WDS-Bridge-Z，就是旧版「新增 wds_z」的行为。
#   这里每次开机再收一次：5G 上只留 ssid=WDS-Bridge-Z 的那个，其余 disabled=1。
wifi_single_5g(){
  [ -f /etc/config/wireless ] || return 0
  # 找 5G radio：channel 优先，其次 hwmode 结尾 a/acaxa
  d=''
  for x in $(uci show wireless 2>/dev/null \
             | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
    ch=$(uci -q get "wireless.$x.channel" 2>/dev/null)
    hw=$(uci -q get "wireless.$x.hwmode" 2>/dev/null)
    case "$ch" in 36|40|44|48|52|56|60|64|100|104|108|112|116|120|124|128|132|136|140|144|149|153|157|161|165) d=$x; break ;; esac
    case "$hw" in *a|*ac*|*axa*) d=$x; break ;; esac
  done
  [ -n "$d" ] || d=wifi1
  keep=''; first=''
  for s in $(uci show wireless 2>/dev/null \
            | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
    [ "$(uci -q get "wireless.$s.device" 2>/dev/null)" = "$d" ] || continue
    [ -z "$first" ] && first=$s
    [ "$(uci -q get "wireless.$s.ssid" 2>/dev/null)" = 'WDS-Bridge-Z' ] && keep=$s
  done
  [ -z "$keep" ] && keep=$first
  [ -z "$keep" ] && return 0
  for s in $(uci show wireless 2>/dev/null \
            | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
    [ "$(uci -q get "wireless.$s.device" 2>/dev/null)" = "$d" ] || continue
    [ "$s" = "$keep" ] && uci -q set "wireless.$s.disabled=0" \
                       || uci -q set "wireless.$s.disabled=1"
  done
  uci -q commit wireless 2>/dev/null || true
  log "5G 单 SSID 兜底：仅 wireless.$keep 广播，其余同 radio VAP disabled=1"
}
ensure(){ # ensure <section-type> <section-name>
  uci -q get "$2" >/dev/null 2>&1 || uci -q set "$2=$1"
}
setv(){ # setv <section> <option> <value>
  [ -z "$3" ] && return 0
  [ "$(uci -q get "$1.$2" 2>/dev/null)" = "$3" ] && return 0
  uci -q set "$1.$2=$3"
}

# ★ 每次开机都跑（不受 applied stamp 限制）：删 WAN/WAN6 + 关 IPv6/防火墙
#   官方 board.d 每次都会重新生成 wan/wan6，光首启删一次不够。
scrub(){
  MODE_S=$(cat /etc/vs010/mode 2>/dev/null || echo wds)
  printf '%s\n' "$MODE_S" > /etc/firmware_mode 2>/dev/null || true   # 旧版 AP 状态页读
  if uci -q get network.lan >/dev/null 2>&1; then
    uci -q delete network.wan   2>/dev/null || true
    uci -q delete network.wan6  2>/dev/null || true
    uci -q delete dhcp.wan6     2>/dev/null || true
    uci -q set network.lan.ifname='eth0 eth1'
    uci -q set network.lan.type='bridge'
    uci -q set network.@switch[0].enable_vlan='0' 2>/dev/null || true
    uci -q commit network 2>/dev/null || true
  fi
  # ★ 第 15 次：四项全关每次开机都跑，绝不受 applied stamp 影响
  kill_ipv6
  kill_dhcp
  kill_firewall
  fix_login
  auto_channel
  # ★ 5G 双保险：先内联兜底（不依赖外部脚本），再让 wds-pair 收敛一次；
  #   wireless 若晚生成，15 秒后重试，保证开局就只有 1 个 SSID。
  if [ "$MODE_S" = wds ]; then
    wifi_single_5g
    if [ -x /usr/sbin/vs010-wds-pair ]; then
      /usr/sbin/vs010-wds-pair converge >/dev/null 2>&1 \
        || ( sleep 15; /usr/sbin/vs010-wds-pair converge ) >/dev/null 2>&1 &
    fi
  fi
  [ -x /usr/sbin/vs010-host ] && /usr/sbin/vs010-host >/dev/null 2>&1 || true
}

# ★ AP 模式 SSID 按机型区分；密码 AP123456（只改现有 wifi-iface，不重建 radio）
set_ap_ssid(){
  MODEL=$(cat /etc/firmware_model 2>/dev/null || echo unknown)
  case "$MODEL" in
    cucc_vs010|*vs010*)      SSID='VS010-AP' ;;
    cmcc_rax3000q|*rax3000q*) SSID='RAX3000Q-AP' ;;
    *) SSID="$(printf '%s' "$MODEL" | tr 'a-z' 'A-Z')-AP" ;;
  esac
  # ★ 第 13 次：按 radio 分组，每个 radio 只留【一个】enabled wifi-iface，
  #   其余 disabled=1（不删段，避免闭源 qca-wifi 的 VAP 索引错乱）。
  #   官方 QSDK 首启会给 5G 生成多个 VAP，之前全开就出现两个 SSID。
  seen=''
  for sec in $(uci show wireless 2>/dev/null \
               | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
    [ -n "$sec" ] || continue
    dev=$(uci -q get "wireless.$sec.device" 2>/dev/null || echo '')
    case " $seen " in
      *" $dev "*) uci -q set "wireless.$sec.disabled=1"; continue ;;
    esac
    seen="$seen $dev"
    uci -q set "wireless.$sec.ssid=$SSID"
    uci -q set "wireless.$sec.encryption=psk2+ccmp"
    uci -q set "wireless.$sec.key=AP123456"
    uci -q set "wireless.$sec.network=lan"
    uci -q set "wireless.$sec.disabled=0"
    # ★ 第 15 次：网桥/AP 都开 MU-MIMO + WMM（字段取自官方 lib/wifi/qcawifi.sh：
    #   wmm=config_get_bool wmm "$vif"、he_ulmumimo / he_mubfer / he_dlofdma /
    #   he_ulofdma 均为 config_get "$vif"，全部走 iwpriv 下发，不是我编的名字）
    uci -q set "wireless.$sec.wmm=1"
    uci -q set "wireless.$sec.he_ulmumimo=1"
    uci -q set "wireless.$sec.he_mubfer=1"
    uci -q set "wireless.$sec.he_dlofdma=1"
    uci -q set "wireless.$sec.he_ulofdma=1"
    # ★ AP 弱信号：剔除 + 拒绝连接（QSDK 私有 iwpriv db_rssi_thr / db_timeout）
    #   阈值可在设备改 /etc/vs010/weak.rssi（默认 -70 dBm），db_timeout 默认 10s
    WEAK=$(cat /etc/vs010/weak.rssi 2>/dev/null || echo -70)
    uci -q set "wireless.$sec.db_rssi_thr=$WEAK"
    uci -q set "wireless.$sec.db_timeout=10"
  done
  uci -q commit wireless 2>/dev/null || true
  printf '%s\n' "$SSID" > /etc/vs010/ap.ssid 2>/dev/null || true
  log "AP SSID 按机型设置 $SSID / AP123456"
}

apply(){
  fix_login        # ★ 放在 stamp 检查之前：即使本次 apply 直接 return 也保证 password
  [ "$(cat "$STAMP" 2>/dev/null)" = "$BID" ] && return 0
  MODE=$(cat /etc/vs010/mode 2>/dev/null || echo wds)
  case "$MODE" in wds|ap) ;; *) MODE=wds ;; esac

  # ── 管理地址 / STP / WAN+LAN 全进桥 / 关 IPv6 ──────────────────
  if uci -q get network.lan >/dev/null 2>&1; then
    ensure interface network.lan
    [ -n "$(uci -q get network.lan.ipaddr 2>/dev/null)" ] || setv network.lan proto static
    # ★ 第 17 次：WDS 主 .241 / 客户端 .242，AP 模式恒 .241
    #   /etc/vs010/ipaddr 由 vs010-role 写入；AP 模式忽略它，避免从客户端
    #   切回 AP 后地址还停在 .242。
    if [ "$MODE_S" = ap ]; then
      IP=172.10.10.241
    else
      R=$(cat /etc/vs010/role 2>/dev/null || echo ap)
      [ "$R" = sta ] && IP=172.10.10.242 || IP=172.10.10.241
      F=$(cat /etc/vs010/ipaddr 2>/dev/null || echo '')
      case "$F" in 172.10.10.241|172.10.10.242) IP=$F ;; esac
    fi
    NM=$(cat /etc/vs010/netmask 2>/dev/null || echo 255.255.252.0)
    setv network.lan ipaddr "$IP"
    setv network.lan netmask "$NM"
    setv network.lan stp 1              # ★ STP 开（网桥/AP 都防环）
    setv network.lan type bridge
    # ★ WAN 口与 LAN 口桥接过来：两个 GMAC 全进 br-lan，删掉 wan/wan6
    #   VS010 官方是 ucidef_set_interfaces_lan_wan "eth1" "eth0"；
    #   RAX3000Q 官方是 switch1 分出 1:wan。统一改成傻交换，不分 WAN。
    setv network.lan ifname 'eth0 eth1'
    uci -q set network.@switch[0].enable_vlan=0 2>/dev/null || true
    uci -q delete network.wan   2>/dev/null || true
    uci -q delete network.wan6  2>/dev/null || true
    uci -q set network.globals.ula_prefix='' 2>/dev/null || true
    setv network.lan ipv6 0             # ★ 关 IPv6（网口/路由都不起 v6）
    if [ "$MODE" = ap ]; then
      # AP：本机不做 DHCP 服务端，交给上级
      uci -q set dhcp.lan.ignore=1 2>/dev/null || true
    fi
  else
    log "network.lan 未生成，后台补跑一次"
    ( sleep 12; sh /etc/init.d/vs010-mode apply ) >/dev/null 2>&1 &
    return 0
  fi

  # ── 无线：只把【radio(wifi-device)】打开；iface 的 enabled 交给模式脚本收敛 ──
  #   🔴 第 13 次：旧写法把 wifi-iface 也一并 disabled=0，会把刚收敛掉的多余
  #   5G VAP 又全部打开 → 双 SSID 复活。绝不重建 radio / iface（保住官方满血栈）。
  uci show wireless 2>/dev/null \
    | sed -n 's/^wireless\.\(.*\)=wifi-device$/\1/p' \
    | while read -r s; do [ -n "$s" ] && uci -q set wireless."$s".disabled=0; done

  # ★ AP 模式：SSID 按机型区分 / AP123456；WDS 模式保持 WDS-Bridge-Z（由 wds-pair 管）
  if [ "$MODE" = ap ]; then set_ap_ssid
  else rm -f /etc/vs010/ap.ssid 2>/dev/null || true; fi

  # ── ★ 关 IPv6（uci + sysctl + 停 odhcpd）─────────────────────────
  uci -q get dhcp.lan >/dev/null 2>&1 || uci -q set dhcp.lan=dhcp
  setv dhcp.lan ra      off
  setv dhcp.lan dhcpv6  off
  setv dhcp.lan ndp     off
  uci -q delete dhcp.wan6 2>/dev/null || true
  sysctl -p /etc/sysctl.d/99-vs010-no-ipv6.conf >/dev/null 2>&1 || true
  /etc/init.d/odhcpd stop    2>/dev/null || true
  /etc/init.d/odhcpd disable 2>/dev/null || true

  # ── ★ 关防火墙（服务停用；纯二层桥不需要 iptables 转发）────────
  /etc/init.d/firewall stop    2>/dev/null || true
  /etc/init.d/firewall disable 2>/dev/null || true

  # ── ★ 精简兜底：构建期已删自启链接，这里把服务再 disable 一次 ──
  for x in autoreboot ddns ddns-go zerotier lldpd quagga dhcrelay4 \
           pppoe-server pppoe-relay miniupnpd relayd mia cnss_diag \
           breakpad diag_socket_app; do
    [ -x "/etc/init.d/$x" ] && /etc/init.d/$x disable 2>/dev/null || true
  done

  # ── ★ root/password 已由 fix_login() 在 scrub() 里每次开机幂等归一（第 15 次）──
  #   不再放在 apply() 里：apply 受 applied stamp 限制，且 passwd 在只读底层会失败。
  # dropbear 不绑 Interface（绑了会在 BOOT 阶段不建实例）
  uci -q delete dropbear.@dropbear[0].Interface 2>/dev/null || true
  uci -q set dropbear.@dropbear[0].PasswordAuth=on
  uci -q set dropbear.@dropbear[0].RootPasswordAuth=on

  # ── ★ 串口：官方 inittab 已有 ttyMSM0::askfirst，缺了才补（写 overlay）──
  if ! grep -q '^ttyMSM0' /etc/inittab 2>/dev/null; then
    printf '\nttyMSM0::askfirst:/bin/ash --login\n' >> /etc/inittab
    kill -HUP 1 2>/dev/null || true
    log '已补串口 getty ttyMSM0'
  fi

  # ── NTP：纯内网客户端，5 分钟循环 + 三台内网时间服务器 ──
  ensure timeserver system.ntp
  setv system.ntp enabled 1
  setv system.ntp enable_server 0            # 只做客户端，不对外提供 NTP
  uci -q delete system.ntp.server 2>/dev/null
  uci -q add_list system.ntp.server=172.10.10.254
  uci -q add_list system.ntp.server=172.100.10.254
  uci -q add_list system.ntp.server=192.168.1.254
  ensure ntp-sync ntp-sync.main
  setv ntp-sync.main enabled 1
  setv ntp-sync.main interval 300
  setv ntp-sync.main timeout 25

  # ── TTYD：官方已装 /usr/bin/ttyd + /etc/init.d/ttyd，只 ensure 启用 ──
  [ -x /etc/init.d/ttyd ] && /etc/init.d/ttyd enable 2>/dev/null || true

  # ── ★ 保证 Argon 主题界面不报错 ──────────────────────────────
  #   官方 /etc/config/luci 是 `config core main`（named section）→ 不会触发
  #   dispatcher.lua:427（旧仓是匿名段才报错）。这里只做只读兜底 + 校正主题。
  # 按「段名」判断，不依赖 uci get 退出码；与 S18 vs010-luci-fix 同逻辑
  sect=$(uci show luci 2>/dev/null \
         | sed -n 's/^luci\.\([^.=]*\)=core$/\1/p' | head -n 1)
  if [ "$sect" != main ]; then
    if [ -n "$sect" ]; then
      uci -q rename "luci.$sect=main"
    else
      uci -q set luci.main=core
    fi
    uci -q set luci.main.lang=zh_cn
    uci -q set luci.main.resourcebase=/luci-static/resources
    log 'luci core 段已归一为 named main（防主题取 nil）'
  fi
  # 官方 90_luci-theme-argon 首启会设；这里再兜底一次，确保主题就是 Argon
  [ "$(uci -q get luci.main.mediaurlbase 2>/dev/null)" = '/luci-static/argon' ] \
    || uci -q set luci.main.mediaurlbase=/luci-static/argon
  [ -f /etc/config/argon ] || log '警告：/etc/config/argon 缺失，Argon 设置页可能异常'
  rm -rf /tmp/luci-indexcache /tmp/luci-modulecache \
         /var/luci-indexcache /var/luci-modulecache 2>/dev/null || true

  # ── 机器狗插件：出厂停用，钥匙交给用户（第 60 次）──
  ensure wdsdog wdsdog.main
  setv wdsdog.main enabled 0
  setv wdsdog.main dryrun 1
  setv wdsdog.main delay 5
  setv wdsdog.main grace 6
  setv wdsdog.main interval 30
  setv wdsdog.main iface auto
  setv wdsdog.main peer auto
  [ -x /etc/init.d/vs010-watchdog ] && /etc/init.d/vs010-watchdog disable 2>/dev/null || true

  # ── DHCP Snooping（无线侧非法 DHCP 服务器防护）：监测模式，不阻断不重启 ──
  ensure dhcp-guard dhcp-guard.main
  setv dhcp-guard.main enabled 1
  setv dhcp-guard.main mode monitor
  setv dhcp-guard.main interval 60
  [ -x /etc/init.d/vs010-dhcp-guard ] && /etc/init.d/vs010-dhcp-guard enable 2>/dev/null || true

  [ -x /etc/init.d/vs010-ntp ] && /etc/init.d/vs010-ntp enable 2>/dev/null || true
  /etc/init.d/dropbear enable 2>/dev/null || true
  /etc/init.d/uhttpd   enable 2>/dev/null || true
  # ★ 网桥模式：自动配对 + WDS 主/客户端纯二层配置（守护首轮 apply 一次）
  if [ "$MODE" = wds ]; then
    : > /etc/vs010/wds.pending
    [ -x /etc/init.d/vs010-wds-pair ] && /etc/init.d/vs010-wds-pair enable 2>/dev/null || true
  else
    [ -x /etc/init.d/vs010-wds-pair ] && /etc/init.d/vs010-wds-pair disable 2>/dev/null || true
  fi
  uci -q commit
  mkdir -p /etc/vs010; printf '%s\n' "$BID" > "$STAMP"
  # 兼容旧版丰富状态页：把角色透出到它读的路径（只读垫片，不改无线配置）
  if [ "$MODE" = wds ]; then
    printf '%s\n' "$(cat /etc/vs010/role 2>/dev/null || echo ap)" > /etc/bridge_role
    printf '%s\n' "$(cat /etc/vs010/role 2>/dev/null || echo ap)" > /etc/qsdk_role
    printf 'auto\n' > /etc/bridge_role_mode
  else
    printf 'ap\n' > /etc/bridge_role
    printf 'ap\n' > /etc/qsdk_role
    printf 'auto\n' > /etc/bridge_role_mode
  fi
  [ -x /usr/sbin/vs010-host ] && /usr/sbin/vs010-host >/dev/null 2>&1 || true
  [ -x /etc/init.d/vs010-luci-fix ] && /etc/init.d/vs010-luci-fix start >/dev/null 2>&1 || true
  log "就绪 mode=$MODE ip=$(uci -q get network.lan.ipaddr)/$(uci -q get network.lan.netmask) stp=$(uci -q get network.lan.stp) build=$BID"
}

start(){ scrub; apply; }
boot(){ scrub; apply; }
