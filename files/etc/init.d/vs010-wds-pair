#!/bin/sh /etc/rc.common
# 网桥自动配对守护：仅 WDS 模式 enable；AP 模式 disable
START=94
USE_PROCD=1
start_service(){
  [ "$(cat /etc/vs010/mode 2>/dev/null)" = wds ] || return 0
  procd_open_instance
  procd_set_param command /usr/sbin/vs010-wds-pair loop
  procd_set_param respawn 10 5 0
  procd_close_instance
}
