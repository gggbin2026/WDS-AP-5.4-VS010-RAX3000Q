#!/bin/sh /etc/rc.common
# 第 20 次：唯一常驻守护（START=96）。原 4 个 procd loop 全部并入 vs010-tick。
START=96
USE_PROCD=1
start_service(){
  procd_open_instance
  procd_set_param command /usr/sbin/vs010-tick
  procd_set_param respawn 10 5 0
  procd_set_param stdout 0
  procd_set_param stderr 0
  procd_close_instance
}
