#!/bin/sh
# 网桥 WDS 自动配对：主(ap) / 客户端(sta) 角色收敛 + 4addr 纯二层桥接配置
# 🔴 绝不重建 radio、绝不 wifi down、绝不重启机器。
# ★ 第 13 次：不再【新增】wireless.wds_z。官方 QSDK 首启会在 5G 上生成多个
#   wifi-iface（原厂 SSID + 可能的 backhaul/guest VAP），旧脚本再挂一个 wds_z
#   → 5G 同时广播两个 SSID。改为【复用 5G 上第一个 iface】作唯一 WDS VAP，
#   同 radio 其余 iface 全部 disabled=1（不删段，避免闭源 VAP 索引错乱）。
PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH
D=/etc/vs010
ROLE=$D/role; PEER=$D/peer; STATE=$D/wds.state
WDS_SEC=wds_z                      # 仅「5G 上无任何 iface」时的兜底段名
WDS_SSID=WDS-Bridge-Z
WDS_KEY=WDS123456
log(){ logger -t vs010-wds-pair "$*" 2>/dev/null || true; }
# ★ r26：界面配置持久化在 /etc/vs010/user.cfg；每次 converge 重读，重启不丢
cfg_get(){ [ -f "$D/user.cfg" ] || { printf ''; return; }; \
           sed -n "s/^$1=//p" "$D/user.cfg" 2>/dev/null | head -n 1; }
resolve_wds(){
  a=$(cfg_get wds_ssid); [ -n "$a" ] || a=WDS-Bridge-Z
  b=$(cfg_get wds_key);  [ -n "$b" ] || b=WDS123456
  c=$(cfg_get ch5g);     [ -n "$c" ] || c=auto
  if [ "$(cat "$ROLE" 2>/dev/null || echo ap)" = sta ]; then
    p=$(cfg_get peer_ssid); [ -n "$p" ] && a=$p
    q=$(cfg_get peer_key);  [ -n "$q" ] && b=$q
    WDS_BSSID=$(cfg_get peer_bssid)
  else
    WDS_BSSID=''
  fi
  WDS_SSID=$a; WDS_KEY=$b; WDS_CH=$c
}
vap(){ for i in ath1 wifi1 wlan1 ath0 wifi0; do
  [ -d "/sys/class/net/$i" ] && { echo "$i"; return; }; done; echo ''; }
mymac(){ for i in br-lan eth0 eth1; do
  [ -r "/sys/class/net/$i/address" ] && { tr -d '\n' < "/sys/class/net/$i/address"; return; }; done; echo ''; }
scan(){
  v=$(vap); [ -z "$v" ] && return 0
  if command -v wlanconfig >/dev/null 2>&1; then
    wlanconfig "$v" list scan 2>/dev/null | sed -n 's/^\([0-9a-fA-F:][0-9a-fA-F:]*\).*/\1/p' | head -8
  elif command -v iw >/dev/null 2>&1; then
    iw dev "$v" scan 2>/dev/null | sed -n 's/^BSS \([0-9a-fA-F:]*\).*/\1/p' | head -8
  fi
}
dev5g(){
  # 找 5G radio 的命名段（QSDK: wifi0=2.4G / wifi1=5G）
  for d in $(uci show wireless 2>/dev/null \
             | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
    hw=$(uci -q get "wireless.$d.hwmode" 2>/dev/null)
    ch=$(uci -q get "wireless.$d.channel" 2>/dev/null)
    # channel 优先（最可靠）；hwmode 只认结尾 a / ac / axa，
    # 🔴 不能用 11a 通配 —— 2.4G 的 11axg 也含 11a，会误选 2.4G
    case "$ch" in 36|40|44|48|52|56|60|64|100|104|108|112|116|120|124|128|132|136|140|144|149|153|157|161|165) echo "$d"; return ;; esac
    case "$hw" in *a|*ac*|*axa*) echo "$d"; return ;; esac
  done
  echo wifi1
}
decide(){
  my=$(mymac | tr 'a-f' 'A-F')
  best=''
  for m in $(scan); do
    M=$(printf '%s' "$m" | tr 'a-f' 'A-F')
    [ "$M" = "$my" ] && continue
    [ -z "$best" ] && best=$M
    [ "$(printf '%s\n%s\n' "$M" "$best" | LC_ALL=C sort | head -1)" = "$M" ] && best=$M
  done
  # 手工指定角色时只更新对端，不覆盖 role
  if [ ! -f "$D/wds.manual" ]; then
    if [ -z "$my" ]; then printf 'unknown\n' > "$ROLE"
    elif [ -z "$best" ]; then printf 'ap\n' > "$ROLE"
    elif [ "$(printf '%s\n%s\n' "$my" "$best" | LC_ALL=C sort | head -1)" = "$my" ]; then
      printf 'ap\n' > "$ROLE"
    else
      printf 'sta\n' > "$ROLE"
    fi
  fi
  printf '%s\n' "$best" > "$PEER"
  printf 'role=%s peer=%s vap=%s t=%s\n' \
    "$(cat "$ROLE" 2>/dev/null)" "$best" "$(vap)" "$(date +%H:%M:%S)" > "$STATE"
  # 联动机器狗：解析到对端 IP 才设 peer，绝不因查不到就判不通
  p=$(cat "$PEER")
  if [ -n "$p" ] && command -v bridge-watchdog >/dev/null 2>&1; then
    low=$(printf '%s' "$p" | tr 'A-F' 'a-f')
    ip=$(ip neigh show dev br-lan 2>/dev/null \
         | awk -v m="$low" 'tolower($3)==m{print $1;exit}')
    [ -n "$ip" ] && bridge-watchdog set-peer "$ip" >/dev/null 2>&1 || true
  fi
}
# ★★ 5G 单 VAP 收敛（第 13 次核心）★★
#   绝不重建 radio：只改既有 wifi-iface 的 option + disabled。
converge(){
  [ -f /etc/config/wireless ] || { log 'wireless 未生成，稍后重试'; return 1; }
  d=$(dev5g)
  role=$(cat "$ROLE" 2>/dev/null || echo ap)
  [ "$role" = sta ] || role=ap
  resolve_wds   # ★ r26：主端 wds_ssid / 客户端 peer_ssid + 信道 + BSSID
  # ★ 第 16 次：无线信道【自动】。官方 qcawifi.sh:1846 明确写着
  #   `[ auto = "$channel" ] && channel=0`，即 auto 是 QSDK 原生合法值，
  #   转 0 后由 ACS 自动选道；后面的 `[ $channel -eq 36 ]` 不会崩。
  #   HE160 仍由 `11axa + HT160` → qcawifi.sh:2578 转 11AHE160，与自动选道不冲突。
  uci -q set "wireless.$d.hwmode=11axa"
  # ★ r29.11：WDS 回程固定在 5.8G 160MHz（HT160 = QSDK HE160 别名，已实机验证）。
  #   2.4G 不参与 WDS 桥接，其 20/40 共存由 vs010-mode / apply-config 单独下发。
  uci -q set "wireless.$d.htmode=HT160"
  uci -q set "wireless.$d.channel=$WDS_CH"
  uci -q set "wireless.$d.disabled=0"
  # 备份一次（只供 off 参考，不整体覆盖）
  [ -f "$D/wireless.orig" ] || cp -f /etc/config/wireless "$D/wireless.orig" 2>/dev/null || true
  primary=''
  for sec in $(uci show wireless 2>/dev/null \
               | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
    [ -n "$sec" ] || continue
    dev=$(uci -q get "wireless.$sec.device" 2>/dev/null)
    if [ "$dev" = "$d" ]; then
      # 5G：第一个留作唯一 WDS VAP，其余全部关掉（不删段）
      if [ -z "$primary" ]; then primary=$sec
      else uci -q set "wireless.$sec.disabled=1"; fi
    else
      # ★ 2.4G 不桥接：清掉可能残留的 wds 标记，保留普通 AP 本地覆盖
      uci -q delete "wireless.$sec.wds"        2>/dev/null || true
      uci -q delete "wireless.$sec.wds_bridge" 2>/dev/null || true
      [ "$(uci -q get "wireless.$sec.mode" 2>/dev/null)" = wds ] \
        && uci -q set "wireless.$sec.mode=ap" || true
    fi
  done
  # 极端兜底：5G 上确实没有任何 iface 才新建（正常实机不会走到）
  if [ -z "$primary" ]; then
    primary=$WDS_SEC
    uci -q set "wireless.$primary=wifi-iface"
    uci -q set "wireless.$primary.device=$d"
  fi
  printf '%s\n' "$primary" > "$D/wds.section"
  uci -q set "wireless.$primary.device=$d"
  uci -q set "wireless.$primary.network=lan"          # ★ 纯二层，进 br-lan
  uci -q set "wireless.$primary.ssid=$WDS_SSID"
  uci -q set "wireless.$primary.encryption=psk2+ccmp"
  uci -q set "wireless.$primary.key=$WDS_KEY"
  uci -q set "wireless.$primary.disabled=0"
  # ★ r26：客户端可填主端 BSSID 定向桥接；不填则清掉旧值，不锁定
  if [ "$role" = sta ] && [ -n "$WDS_BSSID" ]; then
    uci -q set "wireless.$primary.bssid=$WDS_BSSID"
  else
    uci -q delete "wireless.$primary.bssid" 2>/dev/null || true
  fi
  # ★ 第 15 次：网桥模式同样开 MU-MIMO + WMM（官方 qcawifi.sh 识别的字段）
  uci -q set "wireless.$primary.wmm=1"
  uci -q set "wireless.$primary.he_ulmumimo=1"
  uci -q set "wireless.$primary.he_mubfer=1"
  uci -q set "wireless.$primary.he_dlofdma=1"
  uci -q set "wireless.$primary.he_ulofdma=1"
  # ★ 第 16 次：网桥那也要有弱信号剔除 + 拒绝连接（与 AP 同口径）
  #   字段来自官方 qcawifi.sh:2617/2620 的 iwpriv db_rssi_thr / db_timeout。
  WEAK=$(cat /etc/vs010/weak.rssi 2>/dev/null || echo -70)
  uci -q set "wireless.$primary.db_rssi_thr=$WEAK"
  uci -q set "wireless.$primary.db_timeout=$(cat "$D/weak.timeout" 2>/dev/null || echo 10)"
  uci -q delete "wireless.$primary.wds"        2>/dev/null || true
  uci -q delete "wireless.$primary.wds_bridge" 2>/dev/null || true
  if [ "$role" = ap ]; then
    # ★ WDS 主：AP VAP + 4addr（hostapd wds_bridge 把 4addr 帧送进 br-lan）
    uci -q set "wireless.$primary.mode=ap"
    uci -q set "wireless.$primary.wds=1"
    uci -q set "wireless.$primary.wds_bridge=br-lan"
  else
    # ★ WDS 客户端：QSDK 原生 mode=wds → qcawifi.sh 内部设 wds=1 + mode=sta
    uci -q set "wireless.$primary.mode=wds"
  fi
  uci -q commit wireless
  log "5G 单 VAP 收敛：仅 $primary 广播 $WDS_SSID（role=$role / HE160 / network=lan），其余同 radio iface disabled=1"
}
apply(){
  converge || return 1
  log "WDS 应用 role=$(cat "$ROLE" 2>/dev/null || echo ap) ssid=$WDS_SSID network=lan（4addr 纯二层）"
  # 一次标准 reload；失败只告警，绝不重启、绝不 wifi down
  if [ -x /sbin/wifi ]; then
    /sbin/wifi reload >/dev/null 2>&1 \
      || log 'wifi reload 未成功（不重启；可手动 vs010-wds-pair apply）'
  else
    log '缺 /sbin/wifi，配置已写入，重启后生效'
  fi
  printf '%s\n' "$(cat "$ROLE" 2>/dev/null || echo ap)" > "$D/wds.applied"
  rm -f "$D/wds.pending"
  # 设备名跟随角色：主 WDS-Z / 客户端 WDS-K
  [ -x /usr/sbin/vs010-host ] && /usr/sbin/vs010-host >/dev/null 2>&1 || true
  # 兼容旧版丰富状态页（只读垫片）
  printf '%s\n' "$(cat "$ROLE" 2>/dev/null || echo ap)" > /etc/bridge_role
  printf '%s\n' "$(cat "$ROLE" 2>/dev/null || echo ap)" > /etc/qsdk_role
  printf '%s\n' 'auto' > /etc/bridge_role_mode
}
case "${1:-once}" in
  loop)
    sleep 5
    if [ -f "$D/wds.pending" ]; then decide; apply; fi
    while :; do
      [ -f "$D/wds.manual" ] || decide
      sleep 120
    done ;;
  once) decide; cat "$STATE" ;;
  converge) converge && echo "5G 单 VAP 已收敛：$(cat "$D/wds.section") / $WDS_SSID" ;;
  apply) decide; apply; echo 'WDS 配置已应用（/sbin/wifi reload 一次）' ;;
  set-role)
    case "${2:-}" in
      master|ap)   printf 'ap\n'  > "$ROLE"; printf '1\n' > "$D/wds.manual" ;;
      client|sta)  printf 'sta\n' > "$ROLE"; printf '1\n' > "$D/wds.manual" ;;
      auto)        rm -f "$D/wds.manual"; decide ;;
      *) echo '用法: vs010-wds-pair set-role master|client|auto'; exit 1 ;;
    esac
    : > "$D/wds.pending"; apply
    echo "已设为 $2（ssid=$WDS_SSID）" ;;
  off)
    s=$(cat "$D/wds.section" 2>/dev/null || echo "$WDS_SEC")
    d=$(dev5g)
    # 主 VAP 还原成普通 AP（去掉 4addr 参数）
    uci -q delete "wireless.$s.wds"        2>/dev/null || true
    uci -q delete "wireless.$s.wds_bridge" 2>/dev/null || true
    uci -q set "wireless.$s.mode=ap"
    # 同 radio 被收敛关掉的 VAP 恢复
    for x in $(uci show wireless 2>/dev/null \
               | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
      [ "$x" = "$s" ] && continue
      [ "$(uci -q get "wireless.$x.device" 2>/dev/null)" = "$d" ] \
        && uci -q set "wireless.$x.disabled=0" || true
    done
    # 兼容旧版：若存在独立 wds_z 且不是当前主 VAP，删掉
    [ "$s" != "$WDS_SEC" ] && uci -q delete "wireless.$WDS_SEC" 2>/dev/null || true
    uci -q commit wireless
    rm -f "$D/wds.applied" "$D/wds.manual" "$D/wds.pending" "$D/wds.section"
    [ -x /sbin/wifi ] && /sbin/wifi reload >/dev/null 2>&1 || true
    echo 'WDS 参数已移除，5G 恢复普通 AP（原有 VAP 已恢复）' ;;
  status)
    s=$(cat "$D/wds.section" 2>/dev/null || echo "$WDS_SEC")
    echo "role   : $(cat "$ROLE" 2>/dev/null || echo unknown)  (ap=WDS 主 / sta=WDS 客户端)"
    echo "manual : $([ -f "$D/wds.manual" ] && echo 是 || echo 否，自动收敛)"
    echo "peer   : $(cat "$PEER" 2>/dev/null || echo 未发现)"
    echo "vap    : $(vap)   5G radio: $(dev5g)   唯一 WDS 段: $s"
    echo "wds    : mode=$(uci -q get wireless.$s.mode 2>/dev/null || echo 未应用) \
ssid=$(uci -q get wireless.$s.ssid 2>/dev/null || echo 未应用) \
network=$(uci -q get wireless.$s.network 2>/dev/null || echo 未应用)"
    echo "5G     : $(uci -q get wireless.$(dev5g).htmode 2>/dev/null || echo '-') \
ch=$(uci -q get wireless.$(dev5g).channel 2>/dev/null || echo '-')（HE160） | 5G 仅 1 个 SSID | 2.4G 不桥接"
    echo "host   : $(cat /proc/sys/kernel/hostname 2>/dev/null || echo '?')（主 WDS-Z / 客户端 WDS-K）"
    echo "state  : $(cat "$STATE" 2>/dev/null || echo 尚未扫描)"
    echo "注意   : 4addr 是否建立请实机 wlanconfig ath1 list 确认；本脚本不重启机器" ;;
  link)
    v=$(vap); [ -z "$v" ] && { echo '未发现 5G VAP'; exit 1; }
    echo "VAP=$v  WDS=$WDS_SSID"; wlanconfig "$v" list 2>/dev/null | head -12 || true ;;
  *) echo '用法: vs010-wds-pair loop|once|converge|apply|set-role master|client|auto|off|status|link' ;;
esac
