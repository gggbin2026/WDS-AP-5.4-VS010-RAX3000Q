#!/bin/sh
# 第 22 次：VS010 无线诊断（只读，绝不改配置 / 不重载驱动）
PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH
echo "── VS010 无线 / BDF 诊断 $(date '+%F %T') ──"
echo "[机型] $(cat /etc/firmware_model 2>/dev/null || echo unknown) / mode=$(cat /etc/vs010/mode 2>/dev/null || echo ?)"
echo
echo "[1] 无线设备"
iw dev 2>/dev/null | grep -E 'Interface|phy#|ssid|type' || echo '  ⚠ iw dev 无输出（ath11k 未注册）'
echo
echo "[2] 驱动与固件"
ls -1 /sys/module/ath11k* 2>/dev/null | head -5 || echo '  ⚠ ath11k 模块未加载'
for f in /lib/firmware/ath11k/IPQ5018/hw1.0/board-2.bin \
         /lib/firmware/ath11k/qcn6122/hw1.0/board-2.bin; do
  if [ -s "$f" ]; then
    id=$(dd if="$f" bs=1 skip=36 count=37 2>/dev/null | tr -d '\0')
    echo "  $f  $(wc -c < "$f") B  $id"
  else echo "  ⚠ 缺 $f"; fi
done
echo
echo "[3] ath11k / BDF 日志（最近 40 行）"
logread 2>/dev/null | grep -iE 'ath11k|board-2|board_id|qmi.*board|bdf|caldata|firmware.*fail' | tail -40 \
  || echo '  （无匹配日志）'
echo
echo "[4] Q6 / remoteproc"
for r in /sys/class/remoteproc/remoteproc*; do [ -e "$r" ] && echo "  $(basename $r): $(cat $r/state 2>/dev/null) $(cat $r/firmware 2>/dev/null)"; done
echo
echo "[5] 实机基线对照（来自仓库 VS010文件.txt 的 iw dev / dmesg）"
echo "  期望：phy#2 2.4G(ath0/wifi0) + phy#3 5G(ath1/wifi1)，共 2 phy / 4 interface"
echo "  期望：BDF = IPQ5018/bdwlan.b10 + qcn6122/bdwlan.b60，各 131072 B"
nphy=$(ls -1d /sys/class/ieee80211/phy* 2>/dev/null | wc -l)
nif=$(iw dev 2>/dev/null | grep -c 'Interface')
echo "  实测：phy=$nphy / interface=$nif"
echo
echo "[6] 分区表版本（判断是不是大分区 U-Boot）"
grep -E '"(0:ART|0:TRAINING|rootfs)"' /proc/mtd 2>/dev/null | sed 's/^/  /' \
  || echo '  ⚠ /proc/mtd 读不到'
echo "  大分区特征：rootfs = 0x06e00000 (110 MiB)；原厂是 0x02840000"
echo
echo "[7] 判定"
if iw dev 2>/dev/null | grep -q Interface; then
  echo '  ✅ 无线已注册。若 2.4G 或 5G 缺一个，看 [3] 里 qmi-board-id 与容器里的 id 是否对上；'
  echo '     不对就把 reference/variants/board-cucc_vs010.boardid16.ipq5018 换进 package/ipq-wifi/ 重编。'
else
  echo '  🔴 无线未注册。优先看 [3] 是否报 "failed to load board data file" / "board id mismatch"：'
  echo '     ① 缺 board-2.bin → ipq-wifi-cucc_vs010 包没选上'
  echo '     ② board id mismatch → 换 boardid16 备选重新编译'
  echo '     ③ q6_fw.mdt / m3_fw.mdt 缺失 → ath11k-firmware-ipq5018 / qcn6122 包没选上'
fi
