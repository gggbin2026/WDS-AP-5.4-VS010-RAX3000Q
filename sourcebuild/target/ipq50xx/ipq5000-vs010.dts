// SPDX-License-Identifier: (GPL-2.0+)
//
// 第 23 次：VS010 源码编译线 DTS —— 按【本仓库实机资料】修正板级参数
//   · 骨架：kkstone/immortalwrt-ipq50xx @ openwrt-21.02 的 ipq5000-rax3000q.dts
//   · GPIO / LED / pinctrl / bootargs / 分区：来自仓库
//     3000Q-VS010-固件/DTS/vs010.dtb（运行态 FDT 反编译，311 节点）
//     与 3000Q-VS010-固件/VS010文件.txt（实机 SSH 日志，GBK）
//   · 无线 BDF：r22 已补 board-cucc_vs010.*，见 reference/无线修复取证.md
//
// 【r23 改了什么 / 为什么】
//   r22 沿用 3000Q 的 GPIO：reset=23 / wps=38 / LED 24,19,17 —— 全是别的板子。
//   实机 FDT 只有【一个】wps 键 GPIO34，两颗 LED：mesh GPIO33 / pwr GPIO31。
//   恩山互刷变砖案例正是「复位键 GPIO 不一致」。这里按实机值改回。
//   bootargs-append 也按实机 /proc/cmdline 补回 "ubi.mtd=rootfs swiotlb=1"。
//
// 【分区：这台机器已刷三方 U-Boot + 大分区 MIBIB】
//   实机日志 cat /proc/mtd：mtd15 rootfs = 0x06e00000 (110 MiB)
//   vs010.dtb 分区表：rootfs @0x00900000 size 0x06e00000 —— 两者完全一致。
//   注意：核查报告第四章的「原厂 24 分区表」(rootfs_1/rootfs 各 0x2840000)
//   是【原厂】布局，不是这台机器的。分区由 U-Boot 经 qcom,smem-part 填充，
//   DTS 里不要写死 24 分区偏移。
//
// 【switch：默认不动，另有可选 OEM 档】
//   实机 switch_cpu_bmp=0x40 / lan=0x1e / wan=0x00、8 对 ar8327-initvals、
//   4 个 port_phyinfo；3000Q 是 0x48/0x34/0x02、4 对、6 个 port。
//   用户实机反馈「网卡什么都能起来」→ 当前 3000Q 档有线可用，改私有寄存器
//   有让网口全灭的风险。故默认保留，另给 tools/apply-vs010-switch-oem.py
//   + workflow 输入 vs010_switch_oem=true 一键切到实机档（需实机核对 WAN/LAN）。
//
/dts-v1/;

#include "ipq5018.dtsi"

/ {
	model = "CUCC VS010";
	compatible = "cucc,vs010", "qcom,ipq5018";

	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&intc>;

	aliases {
		serial0 = &blsp1_uart1;

		ethernet0 = &mac0;
		ethernet1 = &mac1;

		// r23：实机只有 mesh(GPIO33) / pwr(GPIO31) 两颗 LED，没有 RGB 三色
		led-boot = &led_pwr;
		led-failsafe = &led_mesh;
		led-running = &led_pwr;
		led-upgrade = &led_mesh;
	};

	chosen {
		// Override the root parameter from u-boot
		// Increase coherent_pool size for WiFi
		bootargs-append = " ubi.mtd=rootfs root=/dev/ubiblock0_1 swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {
		q6_mem_regions: q6_mem_regions@4b000000 {
			no-map;
#ifndef CONFIG_ATH11K_MEM_PROFILE_256M
			reg = <0x0 0x4b000000 0x0 0x3b00000>;
#else
			reg = <0x0 0x4b000000 0x0 0x3000000>;
#endif
		};
	};

	thermal-zones {
		status = "ok";
	};
};

&tmc_etr {
	/delete-property/ memory-region;
};

&tlmm {
	blsp_uart0_pins: blsp_uart0_pins {
		pins =
			"gpio28", // RX
			"gpio29"; // TX
		function = "blsp0_uart1";
		drive-strength = <8>;
		bias-disable;
	};

	qspi_nand_pins: qspi_nand_pins {
		clock {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data {
			pins = "gpio7", "gpio6", "gpio5", "gpio4";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	mdio1_pins: mdio1_pins {
		mdc {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	leds_pins: leds_pins {
		// r23：实机 FDT 的 mesh / pwr 两组，bias-pull-down
		mesh {
			pins = "gpio33";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		pwr {
			pins = "gpio31";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	button_pins: button_pins {
		// r23：实机只有 wps 一个键 GPIO34，bias-pull-up
		// （3000Q 的 gpio23/gpio38 在这块板上不存在，勿再用）
		wps_button {
			pins = "gpio34";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
	};
};

&blsp1_uart1 {
	pinctrl-0 = <&blsp_uart0_pins>;
	pinctrl-names = "default";
	status = "ok";
};

&qpic_bam {
	status = "ok";
};

&nand {
	pinctrl-0 = <&qspi_nand_pins>;
	pinctrl-names = "default";
	status = "ok";
};

&tsens {
	status = "ok";
};

&soc {
	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		// r23：取自 vs010.dtb 的 led@35 / led@30，gpios flags=1（低有效）
		led_mesh: led_mesh {
			label = "mesh";
			gpios = <&tlmm 33 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "mesh";
			default-state = "off";
		};

		led_pwr: led_pwr {
			label = "pwr";
			gpios = <&tlmm 31 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pwr";
			default-state = "on";
		};
	};

	button {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		// r23：实机只有这一个键。linux,code=529(0x211)=KEY_WPS_BUTTON，
		// debounce=60，gpios=<phandle 34 1>。没有独立 reset 键 —— 不要凭空加
		// KEY_RESTART，恩山变砖案例就是多采了一个不存在的复位脚。
		button_wps {
			label = "wps";
			gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
	};

	ess-instance {
		num_devices = <2>;

		// Dummy switch, to describe how the external ports connects to the MAC
		// For example, some chips have PSGMII ports which combine 5 MAC into
		// 1 external port.
		// For IPQ50xx, this is used to choose SGMII or SGMII-plus
		ess-switch@0x39c00000 {
			compatible = "qcom,ess-switch-ipq50xx";
			device_id = <0>;

			cmnblk_clk = "internal_96MHz";

			// MAC1 Mode
			// switch_mac_mode = <0xc>; // PORT_WRAPPER_SGMII_PLUS
			switch_mac_mode = <0xf>; // PORT_WRAPPER_SGMII_CHANNEL0

			qcom,port_phyinfo {
				// MAC0 -> GE Phy -> QCA8337 Phy2
				port@0 {
					port_id = <1>;

					mdiobus = <&mdio0>;
					phy_address = <7>;

					phy_dac = <0x10 0x10>;
				};

				// MAC1 ---SGMII---> QCA8337 SerDes
				port@1 {
					port_id = <2>;

					forced-speed = <1000>;
					forced-duplex = <1>;
				};
			};
		};

		// QCA8337 —— r23 默认档：3000Q 已验证值（用户实机「网卡都能起来」）
		// 🔴 切到实机 OEM 档：跑 tools/apply-vs010-switch-oem.py
		//    或在 workflow 里把 vs010_switch_oem 设为 true
		// BEGIN_SWITCH_OEM
		ess-switch1@1 {
			compatible = "qcom,ess-switch-qca83xx";
			device_id = <1>;

			reset_gpio = <26>;

			switch_access_mode = "mdio";
			mdio-bus = <&mdio1>;

			qca,ar8327-initvals = <
				0x000c 0x00000080  // PAD6_MODE = MAC6_SGMII_EN
				0x0010 0x002613a0  // PWS_REG = DEFAULT_VALUE | SERDES_AEN
				0x0094 0x000010ce  // PORT6_STATUS = DEFAULT_VALUE | DUPLEX_MODE_6 | RXMAC_EN_6 |
						   //                TXMAC_EN_6 | SPEED_6(1000M)
				0x00e0 0xc74164de  // SGMII_CTRL = DEFAULT_VALUE | MODE_CTRL_25M(SGMII_PHY) | SGMII_EN_SD |
						   //              SGMII_EN_TX | SGMII_EN_RX | SGMII_EN_PLL
			>;

			switch_cpu_bmp = <0x48>;  // CPU port bitmap: 3 6
			switch_lan_bmp = <0x34>;  // LAN port bitmap: 2 4 5
			switch_wan_bmp = <0x02>;  // WAN port bitmap: 1

			qcom,port_phyinfo {
				// MAC1 -> Phy0 -> WAN
				port@1 {
					port_id = <1>;
					phy_address = <0>;
				};

				// MAC2 -> Phy1 -> LAN1
				port@2 {
					port_id = <2>;
					phy_address = <1>;
				};

				// MAC3 -> Phy2 -> IPQ5000 GE Phy
				port@3 {
					port_id = <3>;
					phy_address = <2>;
				};

				// MAC4 -> Phy3 -> LAN2
				port@4 {
					port_id = <4>;
					phy_address = <3>;
				};

				// MAC5 -> Phy4 -> LAN3
				port@5 {
					port_id = <5>;
					phy_address = <4>;
				};

				// MAC6 ---SGMII---> IPQ5000 MAC1
				port@6 {
					port_id = <6>;

					forced-speed = <1000>;
					forced-duplex = <1>;
				};
			};
		};
		// END_SWITCH_OEM
	};

	// MAC0 -> GE Phy
	mac0: dp1 {
		compatible = "qcom,nss-dp";
		device_type = "network";
		qcom,id = <1>;

		reg = <0x39C00000 0x10000>;
		interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&gcc GCC_SNOC_GMAC0_AXI_CLK>;
		clock-names = "nss-snoc-gmac-axi-clk";

		qcom,mactype = <2>; // GMAC_HAL_TYPE_SYN_GMAC
		local-mac-address = [000000000000];
		mdio-bus = <&mdio0>;
		qcom,phy-mdio-addr = <7>;
		phy-mode = "internal";
		qcom,link-poll = <1>;
	};

	// MAC1 ---SGMII---> QCA8337 SerDes
	mac1: dp2 {
		compatible = "qcom,nss-dp";
		device_type = "network";
		qcom,id = <2>;

		reg = <0x39D00000 0x10000>;
		interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&gcc GCC_SNOC_GMAC1_AXI_CLK>;
		clock-names = "nss-snoc-gmac-axi-clk";

		qcom,mactype = <2>; // GMAC_HAL_TYPE_SYN_GMAC
		local-mac-address = [000000000000];
		phy-mode = "sgmii";
	};
};

&mdio0 {
	status = "ok";

	// IPQ5018 GE Phy -> QCA8337 Phy2
	ethernet-phy@0 {
		reg = <7>;
	};
};

&mdio1 {
	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	status = "ok";

	reset-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;

	// QCA8337 Phy0 -> WAN
	ethernet-phy@0 {
		reg = <0>;
	};

	// QCA8337 Phy1 -> LAN1
	ethernet-phy@1 {
		reg = <1>;
	};

	// QCA8337 Phy2 -> IPQ5018 GE Phy
	ethernet-phy@2 {
		reg = <2>;
	};

	// QCA8337 Phy3 -> LAN2
	ethernet-phy@3 {
		reg = <3>;
	};

	// QCA8337 Phy4 -> LAN3
	ethernet-phy@4 {
		reg = <4>;
	};
};

&q6v5_wcss {
	compatible = "qcom,ipq5018-q6-mpd";
	#address-cells = <1>;
	#size-cells = <1>;
	ranges;

	resets =
		<&gcc GCC_WCSSAON_RESET>,
		<&gcc GCC_WCSS_Q6_BCR>;
	reset-names =
		"wcss_aon_reset",
		"wcss_q6_reset";

	clocks =
		<&gcc GCC_Q6_AXIS_CLK>,
		<&gcc GCC_WCSS_ECAHB_CLK>,
		<&gcc GCC_Q6_AXIM_CLK>,
		<&gcc GCC_Q6_AXIM2_CLK>,
		<&gcc GCC_Q6_AHB_CLK>,
		<&gcc GCC_Q6_AHB_S_CLK>,
		<&gcc GCC_WCSS_AXI_S_CLK>;
	clock-names =
		"gcc_q6_axis_clk",
		"gcc_wcss_ecahb_clk",
		"gcc_q6_axim_clk",
		"gcc_q6_axim2_clk",
		"gcc_q6_ahb_clk",
		"gcc_q6_ahb_s_clk",
		"gcc_wcss_axi_s_clk";

	reg =
		<0x0cd00000 0x4040>,
		<0x1938000 0x8>,
		<0x193d204 0x4>;
	reg-names =
		"qdsp6",
		"tcsr-msip",
		"tcsr-q6";

	memory-region = <&q6_mem_regions>;

	qcom,rproc = <&q6v5_wcss>;
	firmware = "IPQ5018/q6_fw.mdt";

	qcom,bootargs_smem = <507>;
	boot-args = </*       type: */ 0x2 /* PCIE1 */
		     /*     length: */ 4
		     /*      PD id: */ 2
		     /* reset GPIO: */ 27
		     /*   reserved: */ 0 0>;

	status = "ok";

	// IPQ5018
	q6_wcss_pd1: remoteproc_pd1@4ab000 {
		compatible = "qcom,ipq5018-wcss-ahb-mpd";

		resets =
			<&gcc GCC_WCSSAON_RESET>,
			<&gcc GCC_WCSS_BCR>,
			<&gcc GCC_CE_BCR>;
		reset-names =
			"wcss_aon_reset",
			"wcss_reset",
			"ce_reset";

		clocks =
			<&gcc GCC_WCSS_AHB_S_CLK>,
			<&gcc GCC_WCSS_ACMT_CLK>,
			<&gcc GCC_WCSS_AXI_M_CLK>;
		clock-names =
			"gcc_wcss_ahb_s_clk",
					"gcc_wcss_acmt_clk",
					"gcc_wcss_axi_m_clk";

		reg = <0x4ab000 0x20>;
		reg-names = "rmb";

		qcom,halt-regs = <&tcsr_q6_block 0xa000 0xd000 0x0>;

		interrupts-extended =
			<&wcss_smp2p_in 8 0>,
			<&wcss_smp2p_in 9 0>,
			<&wcss_smp2p_in 12 0>,
			<&wcss_smp2p_in 11 0>;
		interrupt-names =
			"fatal",
			"ready",
			"spawn-ack",
			"stop-ack";

		qcom,smem-states =
			<&wcss_smp2p_out 8>,
			<&wcss_smp2p_out 9>,
			<&wcss_smp2p_out 10>;
		qcom,smem-state-names =
			"shutdown",
			"stop",
			"spawn";

		firmware = "IPQ5018/q6_fw.mdt";
		m3_firmware = "IPQ5018/m3_fw.mdt";
	};

	// QCN6102
	q6_wcss_pd2: remoteproc_pd2 {
		compatible = "qcom,ipq5018-wcss-pcie-mpd";

		interrupts-extended =
			<&wcss_smp2p_in 16 0>,
			<&wcss_smp2p_in 17 0>,
			<&wcss_smp2p_in 20 0>,
			<&wcss_smp2p_in 19 0>;
		interrupt-names =
			"fatal",
			"ready",
			"spawn-ack",
			"stop-ack";

		qcom,smem-states =
			<&wcss_smp2p_out 16>,
			<&wcss_smp2p_out 17>,
			<&wcss_smp2p_out 18>;
		qcom,smem-state-names =
			"shutdown",
			"stop",
			"spawn";

		firmware = "IPQ5018/q6_fw.mdt";
		m3_firmware = "qcn6122/m3_fw.mdt";
	};
};

&wifi0 {
	// IPQ5000
	qcom,multipd_arch;
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";

	qcom,board_id = <0x24>;

	qcom,bdf-addr = <0x4c400000 0x4c400000 0x4c400000>;
	qcom,caldb-addr = <0x4d200000 0x4d200000 0>;
#ifndef CONFIG_ATH11K_MEM_PROFILE_256M
	m3-dump-addr = <0x4d400000>;
#else
	m3-dump-addr = <0>;
#endif

	status = "ok";
};

&wifi1 {
	// QCN6102
	qcom,multipd_arch;
	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";

	qcom,board_id = <0x60>;

	qcom,bdf-addr = <0x4d500000 0x4d500000 0x4d100000>;
	qcom,caldb-addr = <0x4e500000 0x4e500000 0>;
#ifndef CONFIG_ATH11K_MEM_PROFILE_256M
	m3-dump-addr = <0x4ea00000>;
#else
	m3-dump-addr = <0x4df00000>;
#endif

	status = "ok";
};
